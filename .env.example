# ErgoGuard AI Environment Configuration Example
# Copy this file to .env if configuring custom parameters

# WebSocket Event Transport
VITE_WS_URL=ws://localhost:8765
PYTHON_WS_PORT=8765
PYTHON_WS_HOST=0.0.0.0

# Video Source (0 for laptop webcam, or path to MP4 file)
VIDEO_SOURCE=0
DEMO_VIDEO_PATH=frontend/public/demo-video.mp4

# Safety Rule Scoring Weights (0-100)
WEIGHT_HELMET=25
WEIGHT_VEST=20
WEIGHT_POSTURE=20
WEIGHT_DANGER_ZONE=35
WEIGHT_FALL=50
